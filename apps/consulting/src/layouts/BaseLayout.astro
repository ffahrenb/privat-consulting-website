---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/theme.css';
import '@fahrenbach/ui/global.css';
import type { Lang } from '../i18n';
import { getAlternateUrl } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'de' } = Astro.props;

const homeTitles = { de: 'Startseite', en: 'Home' };
const pageTitle = title === homeTitles[lang]
  ? 'Florian Fahrenbach – Consulting'
  : `${title} – Florian Fahrenbach, Consulting`;

const currentPath = Astro.url.pathname;
const alternate = getAlternateUrl(currentPath);
const siteUrl = 'https://consulting.fahrenba.ch';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preload" href="/fonts/dm-serif-display-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="alternate" hreflang={alternate.lang} href={`${siteUrl}${alternate.href}`} />
    <link rel="alternate" hreflang={lang} href={`${siteUrl}${currentPath}`} />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
