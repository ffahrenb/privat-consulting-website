---
// Formspree form ID — replace with actual ID after creating the form at formspree.io
const formspreeId = 'YOUR_FORM_ID';
---

<form
  action={`https://formspree.io/f/${formspreeId}`}
  method="POST"
  class="contact-form"
>
  <input type="hidden" name="_next" value="https://psychologie.fahrenba.ch/kontakt/?success=1" />
  <input type="hidden" name="_subject" value="Neue Anfrage über psychologie.fahrenba.ch" />
  <input type="text" name="_gotcha" style="display:none" />

  <div class="form-group">
    <label for="name">Name <span class="required">*</span></label>
    <input type="text" id="name" name="name" required autocomplete="name" />
  </div>

  <div class="form-group">
    <label for="email">E-Mail <span class="required">*</span></label>
    <input type="email" id="email" name="email" required autocomplete="email" />
  </div>

  <div class="form-group">
    <label for="phone">Telefon <span class="optional">(optional)</span></label>
    <input type="tel" id="phone" name="phone" autocomplete="tel" />
  </div>

  <div class="form-group">
    <label for="message">Ihr Anliegen <span class="required">*</span></label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <div class="form-group">
    <label for="referral">Wie sind Sie auf mich aufmerksam geworden? <span class="optional">(optional)</span></label>
    <select id="referral" name="referral">
      <option value="">– Bitte wählen –</option>
      <option value="Suchmaschine">Suchmaschine (Google, etc.)</option>
      <option value="Empfehlung">Empfehlung</option>
      <option value="FSP Psyfinder">FSP Psyfinder</option>
      <option value="Soziale Medien">Soziale Medien</option>
      <option value="Anderes">Anderes</option>
    </select>
  </div>

  <p class="form-privacy">
    Ihre Angaben werden ausschliesslich zur Bearbeitung Ihrer Anfrage verwendet.
    Weitere Informationen finden Sie in der <a href="/datenschutz/">Datenschutzerklärung</a>.
  </p>

  <button type="submit" class="btn btn-primary">Nachricht senden</button>
</form>

<style>
  .contact-form {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .form-group {
    margin-bottom: var(--space-md);
  }

  label {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-primary);
    margin-bottom: 0.375rem;
  }

  .required {
    color: var(--color-accent);
  }

  .optional {
    font-weight: 400;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea,
  select {
    width: 100%;
    padding: 0.625rem 0.75rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color 0.2s;
  }

  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(200, 85, 61, 0.12);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-privacy {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .form-privacy a {
    color: var(--color-text-muted);
  }
</style>
