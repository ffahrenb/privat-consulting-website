---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter(page => page.id.startsWith('en/') && page.id !== 'en/home')
    .map(page => ({
      params: { slug: page.id.replace('en/', '') },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const isContact = page.id === 'en/contact';
const isLegal = page.id === 'en/legal';
---

<BaseLayout title={page.data.title} description={page.data.description} lang="en">
  <section class="page-header">
    <div class="container">
      <h1>{page.data.title}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <Content />
      {isLegal && (
        <div class="fsp-badge">
          <a href="https://www.psychologie.ch" target="_blank" rel="noopener noreferrer">
            <img
              src="/images/fsp-logo.png"
              alt="FSP – Federation of Swiss Psychologists"
              width="100"
              loading="lazy"
              class="fsp-badge-logo"
            />
          </a>
        </div>
      )}
    </div>
  </section>

  {isContact && (
    <section class="section section-alt">
      <div class="container">
        <h2 class="form-heading">Contact form</h2>
        <p class="form-intro">
          Your details will only be used to process your enquiry.
        </p>
        <ContactForm lang="en" />
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .page-header {
    background-color: var(--color-bg-alt);
    padding: var(--space-xl) 0 var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header h1 {
    max-width: var(--max-width);
    margin-bottom: 0;
  }

  .form-heading {
    text-align: center;
    margin-top: 0;
  }

  .form-intro {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    margin-bottom: var(--space-lg);
  }

  .fsp-badge {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
  }

  .fsp-badge-logo {
    width: 100px;
    height: auto;
  }
</style>
