---
import BaseLayout from '@fahrenbach/ui/layouts/BaseLayout.astro';
import CardGrid from '@fahrenbach/ui/components/CardGrid.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';

const startseite = (await getCollection('pages')).find(p => p.id === 'startseite');
if (!startseite) throw new Error('startseite.md not found');

const { Content } = await render(startseite);
---

<BaseLayout title={startseite.data.title} description={startseite.data.description}>
  <section class="hero">
    <div class="container">
      <div class="hero-layout">
        <div class="hero-content">
          <h1>Psychologische Beratung<br />für Menschen in Bewegung.</h1>
          <p class="hero-subline">
            Ich bin Psychologe FSP und begleite Menschen bei Stress, in Veränderungsphasen
            und im Bergsport – wissenschaftlich fundiert, praxisnah und auf Augenhöhe.
          </p>
          <a href="/kontakt/" class="btn btn-primary">Erstgespräch vereinbaren</a>
        </div>
        <div class="hero-portrait">
          <Image
            src={portrait}
            alt="Florian Fahrenbach, Psychologe FSP"
            width={320}
            quality={80}
            class="portrait-img"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-heading">Schwerpunkte</h2>
      <CardGrid />
    </div>
  </section>

  <section class="section cta-section">
    <div class="container prose" style="text-align: center;">
      <h2>Sie möchten herausfinden, ob mein Angebot zu Ihrer Situation passt?</h2>
      <p>
        In einem kurzen, unverbindlichen Erstgespräch klären wir gemeinsam,
        wie ich Sie unterstützen kann. Das Erstgespräch ist kostenlos und dauert ca. 30 Minuten.
      </p>
      <a href="/kontakt/" class="btn btn-outline">Kontakt aufnehmen</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background-color: var(--color-primary);
    color: var(--color-bg);
    padding: var(--space-2xl) 0;
  }

  .hero-layout {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .hero-content {
    flex: 1;
    max-width: var(--max-width);
  }

  .hero h1 {
    color: var(--color-bg);
    font-size: 2.75rem;
    margin-bottom: var(--space-md);
  }

  .hero-subline {
    font-size: 1.1875rem;
    line-height: 1.6;
    opacity: 0.9;
    margin-bottom: var(--space-lg);
    max-width: 580px;
  }

  .hero-portrait {
    flex-shrink: 0;
  }

  .portrait-img {
    border-radius: 50%;
    border: 4px solid rgba(247, 244, 240, 0.2);
    width: 240px;
    height: 240px;
    object-fit: cover;
    object-position: center 20%;
  }

  .section-heading {
    text-align: center;
    margin-top: 0;
    margin-bottom: 0;
  }

  .cta-section h2 {
    margin-top: 0;
  }

  .cta-section p {
    margin-bottom: var(--space-md);
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }

    .hero-subline {
      font-size: 1.0625rem;
    }

    .hero-layout {
      flex-direction: column-reverse;
      text-align: center;
    }

    .hero-subline {
      max-width: 100%;
    }

    .portrait-img {
      width: 180px;
      height: 180px;
    }
  }
</style>
