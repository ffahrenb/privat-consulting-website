---
import BaseLayout from '../layouts/BaseLayout.astro';
import SchwerpunkteGrid from '../components/SchwerpunkteGrid.astro';
import { getCollection, render } from 'astro:content';

const startseite = (await getCollection('pages')).find(p => p.id === 'startseite');
if (!startseite) throw new Error('startseite.md not found');

const { Content } = await render(startseite);
---

<BaseLayout title={startseite.data.title} description={startseite.data.description}>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>Die menschliche Seite<br />der Datenstrategie.</h1>
        <p class="hero-subline">
          Ich bin Psychologe und habe selbst Data Governance aufgebaut.
          Ich unterstütze Organisationen, Führungskräfte und Teams dabei,
          datengetriebene Veränderung so zu gestalten, dass Menschen mitgehen –
          wissenschaftlich fundiert, praxiserprobt und klar.
        </p>
        <a href="/kontakt/" class="btn btn-primary">Erstgespräch vereinbaren</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <Content />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-heading">Schwerpunkte</h2>
      <SchwerpunkteGrid />
    </div>
  </section>

  <section class="section cta-section">
    <div class="container prose" style="text-align: center;">
      <h2>Sie stehen vor einer datengetriebenen Veränderung – und fragen sich, wie Sie die Menschen mitnehmen?</h2>
      <p>
        In einem kurzen, unverbindlichen Erstgespräch klären wir gemeinsam,
        wie ich Sie unterstützen kann.
      </p>
      <a href="/kontakt/" class="btn btn-outline">Kontakt aufnehmen</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background-color: var(--color-primary);
    color: var(--color-bg);
    padding: var(--space-2xl) 0;
  }

  .hero-content {
    max-width: var(--max-width);
  }

  .hero h1 {
    color: var(--color-bg);
    font-size: 2.75rem;
    margin-bottom: var(--space-md);
  }

  .hero-subline {
    font-size: 1.1875rem;
    line-height: 1.6;
    opacity: 0.9;
    margin-bottom: var(--space-lg);
    max-width: 580px;
  }

  .section-heading {
    text-align: center;
    margin-top: 0;
    margin-bottom: 0;
  }

  .cta-section h2 {
    margin-top: 0;
  }

  .cta-section p {
    margin-bottom: var(--space-md);
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }

    .hero-subline {
      font-size: 1.0625rem;
    }
  }
</style>
