{
  "name": "fahrenbach-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:consulting": "bun --cwd apps/consulting run dev",
    "dev:psychologie": "bun --cwd apps/psychologie run dev",
    "build:consulting": "bun --cwd apps/consulting run build",
    "build:psychologie": "bun --cwd apps/psychologie run build",
    "build": "bun run build:consulting && bun run build:psychologie"
  },
  "overrides": {
    "esbuild": "npm:esbuild-wasm@^0.27.5"
  }
}
