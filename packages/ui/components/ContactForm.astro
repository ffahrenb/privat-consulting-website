---
import site from '@site';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const isEn = lang === 'en';
const { formspreeId, contactForm, referralOptions } = site;

const domain = site.siteUrl.replace(/^https?:\/\//, '');
const messageLabel = contactForm.kind === 'topics'
  ? (isEn ? 'Your message' : 'Ihre Nachricht')
  : (isEn ? 'Your message' : 'Ihr Anliegen');
---

<form
  action={`https://formspree.io/f/${formspreeId}`}
  method="POST"
  class="contact-form"
>
  <input type="hidden" name="_next" value={isEn
    ? `${site.siteUrl}/en/contact/?success=1`
    : `${site.siteUrl}/kontakt/?success=1`
  } />
  <input type="hidden" name="_subject" value={isEn
    ? `New enquiry via ${domain}`
    : `Neue Anfrage über ${domain}`
  } />
  <input type="hidden" name="_language" value={lang} />
  <input type="text" name="_gotcha" style="display:none" />

  <div class="form-group">
    <label for="name">{isEn ? 'Name' : 'Name'} <span class="required">*</span></label>
    <input type="text" id="name" name="name" required autocomplete="name" />
  </div>

  <div class="form-group">
    <label for="email">{isEn ? 'Email' : 'E-Mail'} <span class="required">*</span></label>
    <input type="email" id="email" name="email" required autocomplete="email" />
  </div>

  <div class="form-group">
    <label for="phone">{isEn ? 'Phone' : 'Telefon'} <span class="optional">({isEn ? 'optional' : 'optional'})</span></label>
    <input type="tel" id="phone" name="phone" autocomplete="tel" />
  </div>

  {contactForm.kind === 'company' ? (
    <div class="form-group">
      <label for="company">{isEn ? 'Company' : 'Unternehmen'} <span class="optional">({isEn ? 'optional' : 'optional'})</span></label>
      <input type="text" id="company" name="company" autocomplete="organization" />
    </div>
  ) : (
    <div class="form-group">
      <label for="topic">{contactForm.label[lang]} <span class="required">*</span></label>
      <select id="topic" name="topic" required>
        <option value="">{isEn ? '– Please select –' : '– Bitte wählen –'}</option>
        {contactForm.options[lang].map(option => (
          <option value={option}>{option}</option>
        ))}
      </select>
    </div>
  )}

  <div class="form-group">
    <label for="message">{messageLabel} <span class="required">*</span></label>
    <textarea id="message" name="message" rows="5" required></textarea>
  </div>

  <div class="form-group">
    <label for="referral">{isEn ? 'How did you find me?' : 'Wie sind Sie auf mich aufmerksam geworden?'} <span class="optional">({isEn ? 'optional' : 'optional'})</span></label>
    <select id="referral" name="referral">
      <option value="">{isEn ? '– Please select –' : '– Bitte wählen –'}</option>
      {referralOptions[lang].map(option => (
        <option value={option.value}>{option.label}</option>
      ))}
    </select>
  </div>

  <p class="form-privacy">
    {isEn ? (
      <>Your details will only be used to process your enquiry. More information in our <a href="/en/privacy/">Privacy Policy</a>.</>
    ) : (
      <>Ihre Angaben werden ausschliesslich zur Bearbeitung Ihrer Anfrage verwendet. Weitere Informationen finden Sie in der <a href="/datenschutz/">Datenschutzerklärung</a>.</>
    )}
  </p>

  <button type="submit" class="btn btn-primary">{isEn ? 'Send message' : 'Nachricht senden'}</button>
</form>

<style>
  .contact-form {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .form-group {
    margin-bottom: var(--space-md);
  }

  label {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-primary);
    margin-bottom: 0.375rem;
  }

  .required {
    color: var(--color-accent);
  }

  .optional {
    font-weight: 400;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  textarea,
  select {
    width: 100%;
    padding: 0.625rem 0.75rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: border-color 0.2s;
  }

  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-shadow);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-privacy {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .form-privacy a {
    color: var(--color-text-muted);
  }
</style>
