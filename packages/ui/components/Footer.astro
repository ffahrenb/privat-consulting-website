---
import site from '@site';
import type { Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
const currentYear = new Date().getFullYear();
const country = site.address.country[lang];
const telHref = site.phone ? `tel:${site.phone.replace(/\s+/g, '')}` : undefined;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-main">
      <div class="footer-info">
        <p class="footer-name">{site.name}</p>
        <p class="footer-role">{site.tagline[lang]}</p>
        <p class="footer-address">
          {site.address.multiline ? (
            <>{site.address.street}<br />{site.address.postalCity}, {country}</>
          ) : (
            <>{site.address.street}, {site.address.postalCity}, {country}</>
          )}
        </p>
        <p class="footer-email">
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        {site.phone && (
          <p class="footer-phone">
            <a href={telHref}>{site.phone}</a>
          </p>
        )}
      </div>

      <div class="footer-links">
        <nav aria-label={lang === 'en' ? 'Legal' : 'Rechtliches'}>
          <ul>
            {site.legalLinks[lang].map(link => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    {site.badge && (
      <div class="footer-fsp">
        <a href={site.badge.href} target="_blank" rel="noopener noreferrer">
          <img
            src={site.badge.imageSrc}
            alt={site.badge.imageAlt[lang]}
            width="80"
            height="80"
            loading="lazy"
            class="fsp-logo"
          />
        </a>
        <p>{site.badge.text[lang]}</p>
      </div>
    )}

    <div class="footer-cross">
      <p>{site.crossLink.text[lang]} <a href={site.crossLink.url[lang]}>{site.crossLink.label}</a></p>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} {site.name}. {lang === 'en' ? 'All rights reserved.' : 'Alle Rechte vorbehalten.'}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary);
    color: var(--color-bg);
    padding: var(--space-xl) 0 var(--space-md);
    margin-top: var(--space-2xl);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .footer-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin-bottom: 0.125rem;
  }

  .footer-role {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.7;
    margin-bottom: var(--space-sm);
  }

  .footer-address {
    font-size: 0.9375rem;
    line-height: 1.5;
    opacity: 0.85;
    margin-bottom: var(--space-xs);
  }

  .footer-email a {
    color: var(--color-bg);
    opacity: 0.85;
    font-size: 0.9375rem;
  }

  .footer-email a:hover,
  .footer-phone a:hover {
    opacity: 1;
    color: var(--color-bg);
  }

  .footer-phone a {
    color: var(--color-bg);
    opacity: 0.85;
    font-size: 0.9375rem;
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    color: var(--color-bg);
    text-decoration: none;
    font-size: 0.9375rem;
    opacity: 0.75;
    transition: opacity 0.2s;
  }

  .footer-links a:hover {
    opacity: 1;
    color: var(--color-bg);
  }

  .footer-fsp {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-bg-border-subtle);
  }

  .fsp-logo {
    width: 80px;
    height: auto;
    flex-shrink: 0;
  }

  .footer-fsp p {
    font-size: 0.875rem;
    opacity: 0.7;
    margin: 0;
  }

  .footer-cross {
    font-size: 0.875rem;
    opacity: 0.6;
    padding-bottom: var(--space-sm);
  }

  .footer-cross a {
    color: var(--color-bg);
    opacity: 0.85;
  }

  .footer-cross a:hover {
    opacity: 1;
    color: var(--color-bg);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-bg-border);
    padding-top: var(--space-md);
    font-size: 0.8125rem;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .footer-main {
      flex-direction: column;
      gap: var(--space-lg);
    }
  }
</style>
