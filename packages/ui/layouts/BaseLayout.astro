---
import site, { Header, Footer } from '@site';
import '../global.css';
import { getAlternateUrl, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  schema?: Record<string, unknown>[];
}

const { title, description, lang = 'de', schema } = Astro.props;

const homeTitles = { de: 'Startseite', en: 'Home' };
const pageTitle = title === homeTitles[lang]
  ? `${site.name} – ${site.tagline[lang]}`
  : `${title} – ${site.name}, ${site.tagline[lang]}`;

const currentPath = Astro.url.pathname;
const alternate = getAlternateUrl(currentPath, site.slugMap);
const siteUrl = site.siteUrl;
const canonicalUrl = `${siteUrl}${currentPath}`;
const defaultUrl = lang === 'de' ? currentPath : alternate.href;
const ogLocale = lang === 'de' ? 'de_CH' : 'en';
const ogLocaleAlternate = lang === 'de' ? 'en' : 'de_CH';
const ogImage = `${siteUrl}/og.png`;
const jsonLd = schema ? { '@context': 'https://schema.org', '@graph': schema } : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/dm-serif-display-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="alternate" hreflang={alternate.lang} href={`${siteUrl}${alternate.href}`} />
    <link rel="alternate" hreflang={lang} href={`${siteUrl}${currentPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${defaultUrl}`} />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name}, ${site.tagline[lang]}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content={site.themeColor} />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
